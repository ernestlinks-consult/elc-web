# Copy to .env.local for local development. Never commit real values.

# Supabase project URL (from `npm run db:start` locally).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key; safe for the browser because RLS limits what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key; bypasses RLS, server code and Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=
# iSmart SMS API key for lead and staff notifications.
ISMART_API_KEY=
# Resend API key for transactional email.
RESEND_API_KEY=
# Meta oEmbed token for Facebook and Instagram video embeds.
META_OEMBED_TOKEN=
# Shared secret that authorises calls to the revalidation endpoint.
REVALIDATE_SECRET=
# Sentry DSN for error reporting.
SENTRY_DSN=
