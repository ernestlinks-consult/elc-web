# Copy to .env.local for local development. Never commit real values.

# Supabase project URL. `npm run db:start` prints the local value (port 44321).
# next build fails without this and the anon key: the shell reads the database.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key; safe for the browser because RLS limits what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key; bypasses RLS, server code and Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=
# Signs the Start online session cookie. Any long random value; keep it secret.
LEAD_SESSION_SECRET=
# Outbox worker. These belong to the send-notifications Edge Function: set them
# with `supabase secrets set`, not in Vercel. Locally supabase/config.toml has them.
# SMS_PROVIDER is log or ismart; EMAIL_PROVIDER is log, inbucket or resend. There is
# no default, so a live server can never quietly log instead of sending.
SMS_PROVIDER=
EMAIL_PROVIDER=
# Shared secret between pg_cron and the function. notify:run reads it locally.
NOTIFY_CRON_SECRET=
# Site address for portal links in emails.
SITE_URL=
# iSmart SMS. UNVERIFIED: see lib/notify/providers/ismart.ts.
ISMART_API_KEY=
ISMART_API_URL=
ISMART_SENDER_ID=
# Optional, once iSmart's docs confirm them: request field names, response id field,
# json or form body, e164 or digits-only numbers, and text that proves success.
# ISMART_PARAM_KEY=
# ISMART_PARAM_TO=
# ISMART_PARAM_TEXT=
# ISMART_PARAM_SENDER=
# ISMART_RESPONSE_ID_FIELD=
# ISMART_BODY_FORMAT=
# ISMART_PHONE_FORMAT=
# ISMART_SUCCESS_TEXT=
# Resend API key for transactional email.
RESEND_API_KEY=
# Sender for all email, from a verified domain.
EMAIL_FROM=
# Meta oEmbed token for Facebook and Instagram video embeds.
META_OEMBED_TOKEN=
# Absolute site address for canonical URLs and share images.
NEXT_PUBLIC_SITE_URL=
# Shared secret that authorises calls to the revalidation endpoint.
REVALIDATE_SECRET=
# Sentry DSN for error reporting.
SENTRY_DSN=
