# Copy to .env.local for local development. Never commit real values.

# Supabase project URL. `npm run db:start` prints the local value (port 44321).
# next build fails without this and the anon key: the shell reads the database.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key; safe for the browser because RLS limits what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key; bypasses RLS, server code and Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=
# Signs the Start online session cookie. Any long random value; keep it secret.
LEAD_SESSION_SECRET=
# iSmart SMS API key for lead and staff notifications.
ISMART_API_KEY=
# Resend API key for transactional email.
RESEND_API_KEY=
# Meta oEmbed token for Facebook and Instagram video embeds.
META_OEMBED_TOKEN=
# Shared secret that authorises calls to the revalidation endpoint.
REVALIDATE_SECRET=
# Sentry DSN for error reporting.
SENTRY_DSN=
